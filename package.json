    "publish": "python3 scripts/publish.py",
    "sync:api": "python3 scripts/sync_feishu_api.py"
  },
  "dependencies": {
    "three": "0.180.0",
    "typed.js": "2.0.12"
  },
  "devDependencies": {
    "vite": "7.1.4"
  }
}
