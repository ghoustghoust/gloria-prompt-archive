{
  "name": "gloria-prompt-archive",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5182 --strictPort",
    "build": "node scripts/validate.mjs && vite build && node scripts/prune-build-media.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5183 --strictPort",
